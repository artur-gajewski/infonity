LOCAL_AI_DATABASE=data/personal-ai.sqlite3
LOCAL_AI_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_AI_TIMEZONE=Europe/Helsinki
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_EMBEDDING_MODEL=nomic-embed-text
LOCAL_AI_MEMORY_LIMIT=8
LOCAL_AI_MEMORY_TOKENS=1200
LOCAL_AI_EXTRACTION_ENABLED=true
# Verified personal memories save automatically; no Suggestions approval UI.
LOCAL_AI_SENSITIVE_RETRIEVAL=false
# Optional absolute path to a customized, versioned extraction prompt:
# LOCAL_AI_EXTRACTION_PROMPT=/absolute/path/extraction-v2.txt
# Independent deadlines: memory failures fall back to ordinary chat / keyword retrieval.
LOCAL_AI_EXTRACTION_TIMEOUT=90
LOCAL_AI_EMBEDDING_TIMEOUT=15

# Local faster-whisper model directory (Docker supplies /app/speech-model).
LOCAL_AI_SPEECH_MODEL=data/speech-model
